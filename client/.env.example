# Optional, and only for the production build.
#
# Leave this unset when the client is served from the same address as the API:
# the client then calls /api on its own origin, and /api is proxied to the API.
#
# Set it when the client is hosted somewhere else, or it will call its own address
# and get nothing back. The API must also list this client's address in
# CORS_ORIGINS. Vite bakes the value into the bundle at build time, so changing it
# needs a rebuild, not a restart.
VITE_API_URL=https://your-api-host

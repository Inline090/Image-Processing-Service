{
  "name": "@image-processing-service/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Image Processing Service: JWT auth, S3 uploads, Sharp pipeline, PostgreSQL metadata",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:built": "node dist/db/migrate-cli.js",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/*.test.ts\"",
    "worker": "tsx watch src/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@superfaceai/passport-twitter-oauth2": "^1.2.4",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}

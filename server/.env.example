# Copy to server/.env and adjust. .env is gitignored; this template is committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Required — the API refuses to boot without it.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h

DATABASE_URL=postgres://ips:ips@localhost:5432/image_processing

# Leave S3_ENDPOINT empty to talk to real AWS; set it for MinIO.
AWS_REGION=us-east-1
S3_BUCKET=image-processing-originals
S3_ENDPOINT=
SQS_QUEUE_URL=http://localhost:9324/000000000000/transformations

# MinIO local credentials - any non-empty values work for the emulator.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Decode-time protection: reject input images with more pixels than this.
MAX_INPUT_PIXELS=50000000

# Leave SQS_ENDPOINT empty to talk to real AWS; set it for ElasticMQ.
SQS_ENDPOINT=http://localhost:9324

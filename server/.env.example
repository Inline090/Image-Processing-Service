# Copy to server/.env and adjust. .env is gitignored; this template is committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Required — the API refuses to boot without it.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h

DATABASE_URL=postgres://ips:ips@localhost:5432/image_processing

# S3 and SQS. Leave both endpoints empty to talk to real AWS; set them for the
# local emulators that docker compose starts (MinIO and ElasticMQ).
AWS_REGION=us-east-1
S3_BUCKET=image-processing-originals
S3_ENDPOINT=
SQS_ENDPOINT=http://localhost:9324

# Emulator credentials - any non-empty values work for MinIO and ElasticMQ.
# For real AWS, replace these with IAM credentials or remove them and use a
# named profile or SSO - values set here take priority over the default chain.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Decode-time protection: reject input images with more pixels than this.
MAX_INPUT_PIXELS=50000000

# How long a received message stays invisible while it is being processed.
# Must exceed the worst-case processing time, or the job gets picked up twice.
SQS_VISIBILITY_TIMEOUT=300

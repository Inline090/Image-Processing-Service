# Copy to server/.env and adjust. .env is gitignored; this template is committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Required — the API refuses to boot without it.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h

# Sign-in providers, through Passport. Each is optional as a pair of credentials:
# leave a pair empty and its route says the provider is not set up rather than sending
# the browser somewhere that cannot work. Point every callback at
# <OAUTH_CALLBACK_BASE>/<provider>/callback:
#   Google   https://console.cloud.google.com/apis/credentials
#   Facebook https://developers.facebook.com/apps
#   Twitter  https://developer.x.com/en/portal/dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# The base every callback url is built from, so the addresses registered with the
# providers cannot drift out of step with the code.
OAUTH_CALLBACK_BASE=http://localhost:3000/api/auth

# Where the browser is sent after signing in. Always this configured address, never
# one taken from the request, so the callback cannot be aimed somewhere else.
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgres://ips:ips@localhost:5432/image_processing

# Connections one process keeps open to the database. Leave it at the default on a
# long-lived host. Set it to 1 on a Lambda worker: every concurrent invocation is a
# separate process with its own pool, so the database's own pooler has to do the
# multiplexing instead.
DATABASE_POOL_MAX=10

# AWS. Storage and the queue are the real services, and this code uses the standard
# credential chain, so prefer a profile, an instance role or the host's own
# environment over pasting keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Must match the bucket's region, or S3 answers with a confusing redirect error.
AWS_REGION=us-east-1

# The bucket must already exist and stay private. The code never creates it.
S3_BUCKET=image-processing-originals

# Point storage and the queue at the local emulators instead of AWS - the stack in
# docker-compose.yml. Leave both empty to run against the real services. Nothing else in
# the code changes either way, because both speak the same protocol.
# S3_ENDPOINT=http://localhost:9000
# SQS_ENDPOINT=http://localhost:9324

# The queues (transformations and transformations-dlq) are created on first use if
# they are missing, which needs sqs:CreateQueue and sqs:SetQueueAttributes. Create
# them yourself to run with send and receive permissions alone.
SQS_VISIBILITY_TIMEOUT=300

# Decode-time protection: reject input images with more pixels than this.
MAX_INPUT_PIXELS=50000000

# How many images a user may keep. Past this an upload is refused with a 403, so
# nothing is stored that cannot be kept.
HISTORY_LIMIT=20

# How many images a guest account may upload before it has to register. This is a
# lifetime allowance: deleting from the history does not give any of it back.
GUEST_UPLOAD_LIMIT=5

# Comma-separated browser origins allowed to call the API. Empty means same-origin
# only, which is what a single-host deployment needs.
CORS_ORIGINS=

# Number of proxies in front of the API. Set this to 1 behind a load balancer, or
# every visitor is rate limited as though they were a single address.
TRUST_PROXY=

# Tells a user by email when a batch finishes, so nobody has to watch the page. The
# worker sends it. Leave this empty and everything still runs, there is just no email.
RESEND_API_KEY=

# Where notifications come from. The default is Resend's own test sender, which will
# only deliver to the address the account was signed up with - verify a domain before
# pointing this at anything else.
EMAIL_FROM=Lumina <onboarding@resend.dev>
